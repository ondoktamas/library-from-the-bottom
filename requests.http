### Library Management System - manual API walkthrough
### Works with IntelliJ IDEA's built-in HTTP Client and VS Code's "REST Client" extension.
### Run requests top to bottom; IntelliJ captures {{bookId}} / {{borrowerId}} from responses automatically.

@baseUrl = http://localhost:8080

### List books (empty on a fresh start)
GET {{baseUrl}}/api/books

### Add a book with 3 copies (ID is generated server-side: author_title_yearofpublication_edition)
POST {{baseUrl}}/api/books
Content-Type: application/json

{
  "title": "Clean Code",
  "author": "Robert C. Martin",
  "yearOfPublication": 2008,
  "edition": "1st",
  "quantity": 3
}

> {%
    client.global.set("bookId", response.body.id);
%}

### Add a second book, with only 1 copy
POST {{baseUrl}}/api/books
Content-Type: application/json

{
  "title": "Effective Java",
  "author": "Joshua Bloch",
  "yearOfPublication": 2018,
  "edition": "3rd",
  "quantity": 1
}

### Add a book with missing fields -> expect 400
POST {{baseUrl}}/api/books
Content-Type: application/json

{
  "title": "",
  "author": "",
  "yearOfPublication": null,
  "edition": "",
  "quantity": null
}

### Add a book with a non-numeric quantity -> expect 400
POST {{baseUrl}}/api/books
Content-Type: application/json

{
  "title": "Dune",
  "author": "Frank Herbert",
  "yearOfPublication": 1965,
  "edition": "1st",
  "quantity": "a few"
}

### Add the exact same book again -> merges into the existing entry (quantity 3 -> 6), not a 409
POST {{baseUrl}}/api/books
Content-Type: application/json

{
  "title": "Clean Code",
  "author": "Robert C. Martin",
  "yearOfPublication": 2008,
  "edition": "1st",
  "quantity": 3
}

### List books again (still just two distinct books - no duplicate row for Clean Code)
GET {{baseUrl}}/api/books

### Filter books by title (substring, case-insensitive)
GET {{baseUrl}}/api/books?title=clean

### Filter books by author
GET {{baseUrl}}/api/books?author=bloch

### Filter books by exact ID
GET {{baseUrl}}/api/books?id={{bookId}}

### Update a book (title/author/year/edition/quantity - the ID does not change)
PUT {{baseUrl}}/api/books/{{bookId}}
Content-Type: application/json

{
  "title": "Clean Code",
  "author": "Robert C. Martin",
  "yearOfPublication": 2008,
  "edition": "2nd",
  "quantity": 3
}

### Register a borrower (ID is generated server-side: name_dateofbirth)
POST {{baseUrl}}/api/borrowers
Content-Type: application/json

{
  "name": "Jane Doe",
  "dateOfBirth": "1990-05-12",
  "address": "123 Main St"
}

> {%
    client.global.set("borrowerId", response.body.id);
%}

### Register a second borrower, used below to show two different people can borrow the same book
POST {{baseUrl}}/api/borrowers
Content-Type: application/json

{
  "name": "John Smith",
  "dateOfBirth": "1985-01-01",
  "address": "1 Elm Street"
}

> {%
    client.global.set("secondBorrowerId", response.body.id);
%}

### Register a borrower with an invalid name -> expect 400
POST {{baseUrl}}/api/borrowers
Content-Type: application/json

{
  "name": "Jane123",
  "dateOfBirth": "1990-05-12",
  "address": "123 Main St"
}

### List all borrowers
GET {{baseUrl}}/api/borrowers

### Get borrower details
GET {{baseUrl}}/api/borrowers/{{borrowerId}}

### Get a borrower that doesn't exist -> expect 404
GET {{baseUrl}}/api/borrowers/does_not_exist

### Update a borrower (name/date of birth/address only - the ID does not change)
PUT {{baseUrl}}/api/borrowers/{{borrowerId}}
Content-Type: application/json

{
  "name": "Jane Doe",
  "dateOfBirth": "1990-05-12",
  "address": "456 Oak Ave"
}

### Jane borrows Clean Code (quantity 3 -> 2)
POST {{baseUrl}}/api/books/{{bookId}}/borrow
Content-Type: application/json

{
  "borrowerId": "{{borrowerId}}"
}

> {%
    client.global.set("loanId", response.body.loanId);
%}

### Jane tries to borrow the very same book again -> expect 409 (one borrower, one copy of a given book at a time)
POST {{baseUrl}}/api/books/{{bookId}}/borrow
Content-Type: application/json

{
  "borrowerId": "{{borrowerId}}"
}

### John borrows a different copy of the same book -> succeeds (quantity 2 -> 1)
POST {{baseUrl}}/api/books/{{bookId}}/borrow
Content-Type: application/json

{
  "borrowerId": "{{secondBorrowerId}}"
}

### Borrow with a borrower that doesn't exist -> expect 404
POST {{baseUrl}}/api/books/{{bookId}}/borrow
Content-Type: application/json

{
  "borrowerId": "does_not_exist"
}

### List books borrowed by Jane
GET {{baseUrl}}/api/borrowers/{{borrowerId}}/books

### List all active loans
GET {{baseUrl}}/api/loans

### List all books (Clean Code should now show "quantity": 1)
GET {{baseUrl}}/api/books

### Jane returns her copy (deletes the loan, quantity 1 -> 2)
DELETE {{baseUrl}}/api/loans/{{loanId}}

### Now that she's returned it, Jane can borrow Clean Code again
POST {{baseUrl}}/api/books/{{bookId}}/borrow
Content-Type: application/json

{
  "borrowerId": "{{borrowerId}}"
}

### Delete a book (also removes its active loan, if any)
DELETE {{baseUrl}}/api/books/{{bookId}}

### Delete a borrower (also removes their active loan, if any)
DELETE {{baseUrl}}/api/borrowers/{{borrowerId}}
